# Copie este ficheiro para .env e preencha os valores

# Servidor
PORT=3000
JWT_SECRET=coloque_aqui_uma_chave_secreta_longa_e_aleatoria

# Stripe (https://dashboard.stripe.com/apikeys)
# Funciona com conta bancária espanhola/europeia ✅
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLIC_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# URL da plataforma (onde está hospedado)
APP_URL=http://localhost:3000

# API SMM Wholesale (ex: SMM-World, Peakerr, JustAnotherPanel)
SMM_API_URL=https://smm-world.com/api/v2
SMM_API_KEY=sua_chave_api_smm

# IDs dos serviços no painel SMM wholesale
# (veja na documentação do seu fornecedor)
SMM_SERVICE_SEGUIDORES_100=1
SMM_SERVICE_SEGUIDORES_500=2
SMM_SERVICE_SEGUIDORES_1000=3
SMM_SERVICE_CURTIDAS_50=4
SMM_SERVICE_CURTIDAS_100=5
SMM_SERVICE_CURTIDAS_500=6
SMM_SERVICE_COMENTARIOS_10=7
SMM_SERVICE_COMENTARIOS_50=8
